---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const SITE_NAME = "AI Assurance Signals";
const {
  title,
  description = "A weekly, source-grounded digest of AI assurance and governance developments — Australia first.",
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <div class="disclaimer" role="note">
      <div class="wrap">
        Summaries on this site are AI-generated from the linked sources and may contain errors. Always rely on the original.
      </div>
    </div>
    <header class="masthead">
      <div class="wrap">
        <a class="brand" href="/">AI Assurance <span>Signals</span></a>
        <span class="tagline">AI assurance &amp; governance · Australia first · weekly</span>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer>
      <div class="wrap">
        Published every Friday afternoon (AEST/AEDT). Built in the open at{" "}
        <a href="https://github.com/flexo333/ai-assurance-signals">github.com/flexo333/ai-assurance-signals</a>.
      </div>
    </footer>
  </body>
</html>
