---
import ItemCard from "./ItemCard.astro";
import { editionLabel, fmtDate, sectionHref } from "../lib/data.js";
interface Props { edition: any; itemsById: Map<string, any>; latest?: boolean }
const { edition, itemsById, latest } = Astro.props;
const get = (id: string) => itemsById.get(id);
// Grouped coverage of the same story (`also` on an entry), resolved to items.
const alsoFor = (ref: any) => (ref.also || []).map(get).filter(Boolean);
const topRefs = edition.topSignals.filter((t: any) => get(t.id));
// Intro citations may name a grouped item: it takes its lead's rank.
const rankOf = new Map(topRefs.flatMap((t: any, k: number) => [t.id, ...(t.also || [])].map((id: string) => [id, { rank: k + 1, lead: t.id }])));
const citesOf = (s: any) => [...new Map(s.cites.map((id: string) => rankOf.get(id)).filter(Boolean).map((r: any) => [r.rank, r])).values()];
---
<header class="edition-head">
  <p class="kicker">{latest ? "Latest edition" : "Edition"} · {editionLabel(edition.id)}</p>
  <h1>The week in AI assurance and governance</h1>
  {edition.backfilled ? (
    <p class="muted">Backfilled archive edition · items published {fmtDate(edition.window.from)} – {fmtDate(edition.window.to)}. Compiled after the fact from what our sources' feeds still held, so it may be incomplete.</p>
  ) : (
    <p class="muted">Published {fmtDate(edition.publishedAt)} · covering {fmtDate(edition.window.from)} – {fmtDate(edition.window.to)}</p>
  )}
</header>

{edition.intro && (
  <section class="intro" aria-label="This week">
    <p class="lede">
      {edition.intro.sentences.map((s: any) => (
        <>{s.text.replace(/[.!?]$/, "")}<sup>{citesOf(s).map((r: any, k: number) => <>{k > 0 && ","}<a href={`#item-${r.lead}`}>{r.rank}</a></>)}</sup>{s.text.match(/[.!?]$/)?.[0] ?? "."} </>
      ))}
    </p>
  </section>
)}

{topRefs.length > 0 && (
  <section aria-labelledby="top">
    <h2 id="top">Top Signals</h2>
    {topRefs.map((ref: any, k: number) => <div id={`item-${ref.id}`}><ItemCard item={get(ref.id)} rank={k + 1} also={alsoFor(ref)} /></div>)}
  </section>
)}

{edition.sections.map((sec: any) => (
  <section aria-labelledby={sec.id}>
    <h2 id={sec.id} class="section-head">{sec.title} <a class="section-head__all" href={sectionHref(sec.id)} aria-label={`All ${sec.title} stories`}>All stories →</a></h2>
    {sec.items.filter((ref: any) => get(ref.id)).map((ref: any) => <div id={`item-${ref.id}`}><ItemCard item={get(ref.id)} also={alsoFor(ref)} /></div>)}
    {sec.more?.length > 0 && (
      <details class="more">
        <summary>{sec.more.length} more in {sec.title}</summary>
        <ul class="plain">
          {sec.more.filter((ref: any) => get(ref.id)).map((ref: any) => {
            const item = get(ref.id);
            return (
              <li id={`item-${item.id}`}>
                <a href={item.url} rel="noopener">{item.status === "summarised" ? item.headline : item.title}</a>
                <span class="muted small"> · {item.sourceName}{item.status !== "summarised" ? " · summary withheld" : ""}</span>
                {alsoFor(ref).length > 0 && <span class="muted small"> · also {alsoFor(ref).map((a: any, k: number) => <>{k > 0 && ", "}<a href={a.url} rel="noopener">{a.sourceName}</a></>)}</span>}
              </li>
            );
          })}
        </ul>
      </details>
    )}
  </section>
))}

{topRefs.length === 0 && edition.sections.length === 0 && <p>No qualifying items were collected this week.</p>}
