---
import Base from "../layouts/Base.astro";
import { loadAll, AUTHORITY_LABEL, AUTHORITY_ORDER } from "../lib/data.js";
const { sources } = loadAll();
const active = sources.filter((s: any) => s.status !== "blocked" && s.status !== "pending");
const pending = sources.filter((s: any) => s.status === "pending");
const blocked = sources.filter((s: any) => s.status === "blocked");
const groups = AUTHORITY_ORDER.map((a) => ({ a, list: active.filter((s: any) => s.authority === a) })).filter((g) => g.list.length);
---
<Base title="Sources" description="The allow-list of sources AI Assurance Signals monitors, and the ones it cannot.">
  <h1>Sources</h1>
  <p>Content comes <strong>only</strong> from this allow-list — never from open web search. Each item carries its source's authority badge.</p>
  <p class="muted small"><strong>Industry</strong> sources are banks, insurers, super funds and financial-services peak bodies writing about their own AI work. <strong>Vendor</strong> sources are cloud and enterprise vendors' customer stories; they are checked against an extra keyword filter so only Australian financial-services stories are processed, and they never lead an edition or a story. Sources marked <em>FS</em> feed the <a href="/financial-services/">Financial Services</a> tracker.</p>
  {groups.map((g) => (
    <section>
      <h2><span class={`badge badge--${g.a}`}>{AUTHORITY_LABEL[g.a]}</span></h2>
      <ul class="plain">
        {g.list.map((s: any) => <li><a href={s.homepage} rel="noopener">{s.name}</a> <span class="muted small">{s.jurisdiction}{s.sector === "financial-services" ? " · FS" : ""}{s.paywalled ? " · paywalled (headline and standfirst only)" : ""}</span></li>)}
      </ul>
    </section>
  ))}
  {pending.length > 0 && (
    <section>
      <h2>Being verified</h2>
      <p>Added to the allow-list but not collected yet: we first check each one's robots.txt, feeds and page structure.</p>
      <ul class="plain">
        {pending.map((s: any) => <li><span class={`badge badge--${s.authority}`}>{AUTHORITY_LABEL[s.authority]}</span> {s.name} <span class="muted small">{s.jurisdiction}{s.sector === "financial-services" ? " · FS" : ""}</span></li>)}
      </ul>
    </section>
  )}
  <section>
    <h2>Not directly monitored</h2>
    <p>These sources block automated access (or disallow it in robots.txt). We respect that and don't work around it, so their announcements reach the digest through news coverage instead.</p>
    <ul class="plain">
      {blocked.map((s: any) => <li>{s.name} <span class="muted small">— {s.blocked_reason}</span></li>)}
    </ul>
  </section>
</Base>
