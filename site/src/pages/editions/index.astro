---
import Base from "../../layouts/Base.astro";
import { loadAll, editionLabel, fmtDate } from "../../lib/data.js";
const { editions } = loadAll();
---
<Base title="Archive" description="All past editions of AI Assurance Signals.">
  <h1>Archive</h1>
  {editions.length === 0 ? <p class="muted">No editions yet.</p> : (
    <ul class="archive">
      {editions.map((e: any) => (
        <li>
          <a href={`/editions/${e.id}/`}>{editionLabel(e.id)}</a>
          <span class="muted"> · published {fmtDate(e.publishedAt)} · {e.topSignals.length + e.sections.reduce((n: number, s: any) => n + s.items.length, 0)} items</span>
        </li>
      ))}
    </ul>
  )}
</Base>
