---
import Base from "../layouts/Base.astro";
import Edition from "../components/Edition.astro";
import { loadAll } from "../lib/data.js";
const { editions, itemsById } = loadAll();
const latest = editions.find((e: any) => !e.backfilled) || editions[0];
---
<Base>
  {latest ? (
    <Edition edition={latest} itemsById={itemsById} latest />
  ) : (
    <>
      <p class="kicker">Coming soon</p>
      <h1>The week in AI assurance and governance.</h1>
      <p class="lede">
        A weekly digest for risk and compliance professionals, AI practitioners, and executives and boards,
        drawn from Australian and international regulators, standards bodies, frontier AI labs and quality news.
      </p>
      <p class="muted">The first edition is in preparation. Editions publish on Friday afternoons (AEST/AEDT).</p>
    </>
  )}
</Base>
